{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PENDING",
        "REVIEWED"
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "requirement_or_topic_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "IDs de topics de interview.json o IDs de requirements del PRD. validate_prd.py aporta el catálogo de requisitos; la validación de entrevista aislada solo puede resolver topics."
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "tradeoffs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "description",
                "source_ids",
                "tradeoffs"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "falsifier": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROPOSED",
              "EVIDENCE_PENDING",
              "ACCEPTED",
              "REJECTED"
            ]
          },
          "decision_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "problem",
          "requirement_or_topic_ids",
          "alternatives",
          "criteria",
          "hypothesis",
          "falsifier",
          "status",
          "decision_source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "no_change_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project",
    "status",
    "proposals",
    "no_change_reason",
    "source_ids",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-grounded design proposals v2"
}

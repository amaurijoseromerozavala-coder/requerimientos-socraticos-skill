#!/usr/bin/env bash
# Optional portable wrapper. The installed skill also works without this wrapper.
set -euo pipefail
wrapper=$(readlink -f -- "${BASH_SOURCE[0]}")
project_dir=$(cd -- "$(dirname -- "$wrapper")/.." && pwd -P)
if [[ "${1:-}" == requirements ]]; then
    shift
    exec bash "$project_dir/skills/requerimientos-socraticos/scripts/requirements" "$@"
fi
# Preserve the caller's runtime configuration; never inject a reviewer profile.
upstream=${GENTLE_AI_UPSTREAM:-$project_dir/libexec/gentle-ai-4.2.0}
if [[ "$upstream" != /* || ! -f "$upstream" || ! -x "$upstream" || "$upstream" -ef "$wrapper" ]]; then
    printf '%s\n' '{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"Set GENTLE_AI_UPSTREAM to the absolute path of the real Gentle AI binary, not this wrapper. Requirements helpers work independently."}}'
    exit 2
fi
exec "$upstream" "$@"

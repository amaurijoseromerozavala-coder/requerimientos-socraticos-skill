  "code": "\nimport sys,resource,json,contextlib,io,tempfile\nfrom pathlib import Path\nfrom unittest.mock import patch\nscripts=Path(sys.argv[1]);sys.path.insert(0,str(scripts));import activation_preflight as a, analyze_logic as logic, validate_git as git\nM=a.MIB; results=[]\n# Deterministic role constraints; mocks observe only, no parent limit mutation.\nfor hard,workload,scope,baseline,requested,expected,profile in [(128,'git',a.EXTERNAL,100,None,'READY_FOR_LIVE_ADMISSION',256),(128,'logic',a.EXTERNAL,100,None,'INCONCLUSIVE',None),(384,'logic',a.EXTERNAL,100,None,'READY_FOR_LIVE_ADMISSION',432),(384,'logic',a.EXTERNAL,100,512,'INCONCLUSIVE',None),(1024,'logic',a.OWNED,100,None,'INCONCLUSIVE',None),(1024,'logic',a.EXTERNAL,100,None,'READY_FOR_LIVE_ADMISSION',512)]:\n with patch.object(a.memory_budget.resource,'getrlimit',return_value=(hard*M,hard*M)),patch.object(a.memory_budget,'_visible_headroom',return_value=(2048*M,{},{})):\n  r=a.evaluate('/tmp',requested,workload=workload,caller_scope=scope,baseline_bytes=baseline*M)\n assert r['status']==expected,r\n assert r['policy']['effective_profile_mib']==profile,r\n assert r['execution']['enforced']==[] and r['execution']['control_state']=='PENDING'\n results.append({'role_case':[hard,workload,scope,baseline,requested],'status':r['status'],'profile':profile})\n# Saved ready report is irrelevant: new public calls must resample unknown headroom.\nwith patch.object(a.memory_budget,'_visible_headroom',return_value=(2048*M,{},{})):\n saved=a.evaluate('/tmp',workload='logic',caller_scope=a.EXTERNAL)\nassert saved['status']=='READY_FOR_LIVE_ADMISSION'\nlimits=resource.getrlimit(resource.RLIMIT_AS)\nwith patch.object(a.memory_budget,'_visible_headroom',side_effect=a.memory_budget.ResourceBudgetError('RESOURCE_HEADROOM_UNKNOWN')),patch.object(logic,'run_supervised') as worker,patch.object(sys,'argv',['analyze','unused.json']),contextlib.redirect_stdout(io.StringIO()) as out:\n rc=logic.main()\nassert rc==3 and json.loads(out.getvalue())['error']['code']=='RESOURCE_HEADROOM_UNKNOWN';worker.assert_not_called();assert resource.getrlimit(resource.RLIMIT_AS)==limits\nresults.append({'public':'analyze.main','after_activation':'UNKNOWN','worker_calls':worker.call_count,'caller_limits_unchanged':True})\nwith patch.object(a.memory_budget,'_visible_headroom',side_effect=a.memory_budget.ResourceBudgetError('RESOURCE_HEADROOM_UNKNOWN')),patch.object(git,'run_supervised') as worker:\n try: git.validate_commit('/tmp','a'*64,'prd.json')\n except git.InvalidGit as e: assert str(e)=='RESOURCE_HEADROOM_UNKNOWN'\n else: raise AssertionError('accepted unknown')\n worker.assert_not_called(); assert resource.getrlimit(resource.RLIMIT_AS)==limits\nresults.append({'public':'validate_commit','after_activation':'UNKNOWN','worker_calls':worker.call_count,'caller_limits_unchanged':True})\n# Real worker tiny model, observed AS limits and applied state.\nwith tempfile.TemporaryDirectory() as td:\n model=Path(td)/'model.json';model.write_text(json.dumps({'inputs':[],'outputs':[],'domain':True,'rules':[],'properties':[]}))\n with patch.object(sys,'argv',['analyze',str(model),'--timeout','3']),contextlib.redirect_stdout(io.StringIO()) as out:\n  rc=logic.main()\n r=json.loads(out.getvalue());assert rc==0,r\n import jsonschema\n schema=json.loads((scripts.parent/'assets/activation-preflight.schema.json').read_text());jsonschema.Draft202012Validator(schema).validate(r['memory_budget']['activation_preflight'])\n ex=r['memory_budget']['activation_preflight']['execution'];assert ex['control_state']=='APPLIED' and len(ex['enforced'])==3,r\n assert resource.getrlimit(resource.RLIMIT_AS)==limits\n assert r['memory_observation']['as_hard_bytes']==r['memory_budget']['policy']['roles_bytes']['solver']\n results.append({'public':'analyze.main','real_worker':True,'result_keys':list(r),'execution':ex,'caller_limits_unchanged':True,'observed_hard':r['memory_observation']['as_hard_bytes']})\nprint(json.dumps(results))\n",
